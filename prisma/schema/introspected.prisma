model ApplicationActivityLog {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId     String?      @db.Uuid
  userId            String?      @db.Uuid
  userRole          String?
  actionType        String
  actionDescription String
  previousStatus    String?
  currentStatus     String?
  metadata          Json?
  createdAt         DateTime?    @default(now()) @db.Timestamptz(6)
  Application       Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_activity_application")
  User              User?        @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "fk_application_activity_user")
}

model BankAnalysis {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String            @db.Uuid
  bankName        String?
  accountNumber   String
  createdById     String            @db.Uuid
  createdAt       DateTime?         @default(now()) @db.Timestamp(6)
  updatedAt       DateTime?         @default(now()) @db.Timestamp(6)
  Application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bank_analysis_application")
  User            User              @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bank_analysis_user")
  BankAnalysisRow BankAnalysisRow[]

  @@index([applicationId])
  @@index([createdById])
}

model BankAnalysisRow {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAnalysisId String       @db.Uuid
  monthLabel     String
  monthDate      DateTime     @db.Timestamp(6)
  totalCredit    Float?       @default(0)
  loanTransfer   Float?       @default(0)
  deposit        Float?       @default(0)
  other          Float?       @default(0)
  nsfNegDays     Float?       @default(0)
  lowBlcDays     Float?       @default(0)
  avgDailyBlc    Float?       @default(0)
  createdAt      DateTime?    @default(now()) @db.Timestamp(6)
  updatedAt      DateTime?    @default(now()) @db.Timestamp(6)
  BankAnalysis   BankAnalysis @relation(fields: [bankAnalysisId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bank_analysis_row_analysis")

  @@index([bankAnalysisId])
}

model FinalAnswer {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String      @db.Uuid
  questionKey   String
  questionLabel String
  answer        String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @db.Timestamptz(6)
  Application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([applicationId, questionKey])
  @@index([applicationId])
}

model FundingCall {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId     String      @db.Uuid
  callStatus        String
  applicationStatus String?
  remarks           String?
  followUpDate      DateTime?   @db.Timestamp(6)
  createdById       String      @db.Uuid
  createdAt         DateTime    @default(now()) @db.Timestamp(6)
  updatedAt         DateTime    @default(now()) @db.Timestamp(6)
  Application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User              User        @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([applicationId])
  @@index([createdById])
}

model OfferDecision {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String      @unique @db.Uuid
  decision        String
  position        String?
  offer           Decimal?    @db.Decimal(18, 2)
  rate            Decimal?    @db.Decimal(18, 6)
  term            String?
  frequency       String?
  repayPerPeriod  Decimal?    @db.Decimal(18, 2)
  monthlyPayment  Decimal?    @db.Decimal(18, 2)
  fees            Decimal?    @db.Decimal(18, 6)
  ourRemit        Decimal?    @db.Decimal(18, 6)
  totalRemit      Decimal?    @db.Decimal(18, 6)
  notes           String?
  declineReason   String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @db.Timestamptz(6)
  userId          String?     @db.Uuid
  refinanceAmount Decimal?    @map("RefinanceAmount") @db.Decimal(18, 2)
  contract        Contract?
  Application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user            User?       @relation(fields: [userId], references: [id])

  @@index([applicationId])
}

model ClientBankInfo {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String       @db.Uuid
  applicationId String?      @db.Uuid
  bankName      String?
  accountNumber String
  routingNumber String
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @db.Timestamptz(6)
  Application   Application? @relation(fields: [applicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([applicationId])
  @@index([clientId])
}

model PublicApprovalToken {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash     String      @unique
  applicationId String      @db.Uuid
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  Application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model CollectionPayment {
  id                  String                  @id @default(uuid()) @db.Uuid
  paymentNumber       Int?
  applicationId       String                  @db.Uuid
  scheduledDate       DateTime
  processedDate       DateTime?
  amount              Decimal                 @db.Decimal(12, 2)
  status              CollectionPaymentStatus @default(SCHEDULED)
  referenceNumber     String?
  externalOrderId     String?
  source              CollectionPaymentSource @default(SYSTEM)
  notes               String?
  createdById         String?                 @db.Uuid
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  Date                DateTime?               @db.Date
  returnDate          DateTime?               @map("ReturnDate") @db.Date
  dealId              String?
  TransactionCategory String?
  transactionStatus   String?
  Application         Application             @relation(fields: [applicationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  User                User?                   @relation(fields: [createdById], references: [id])

  @@index([applicationId])
  @@index([createdById])
  @@index([referenceNumber])
  @@index([scheduledDate])
  @@index([status])
  @@index([dealId])
  @@index([transactionStatus])
  @@index([TransactionCategory])
}

model PaymentTemplate {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  category    PaymentTemplateType
  variables   String[]            @default([])
  body        String
  status      String              @default("active")
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  User        User?               @relation(fields: [createdById], references: [id])

  @@index([category])
  @@index([createdById])
  @@index([updatedAt])
}

model superAdminPlateform {
  id                        String   @id @default("platform")
  clientCount               Int      @default(0)
  isoCount                  Int      @default(0)
  totalDealsCount           Int      @default(0)
  fundedDealsCount          Int      @default(0)
  dealCount                 Int      @default(0)
  commissionPortalDealCount Int      @default(0)
  commissionDealsFunded     Int      @default(0)
  totalCommission           Decimal  @default(0) @db.Decimal(14, 2)
  commissionPaid            Decimal  @default(0) @db.Decimal(14, 2)
  commissionPending         Decimal  @default(0) @db.Decimal(14, 2)
  commissionProcessing      Decimal  @default(0) @db.Decimal(14, 2)
  commissionApproved        Decimal  @default(0) @db.Decimal(14, 2)
  commissionClawback        Decimal  @default(0) @db.Decimal(14, 2)
  totalFundedVolume         Decimal  @default(0) @db.Decimal(14, 2)
  fundedTotal               Decimal  @default(0) @db.Decimal(14, 2)
  netFundingTotal           Decimal  @default(0) @db.Decimal(14, 2)
  abovePrincipalTotal       Decimal  @default(0) @db.Decimal(14, 2)
  recoveredAmount           Decimal  @default(0) @db.Decimal(14, 2)
  failedPaymentAmount       Decimal  @default(0) @db.Decimal(14, 2)
  failedPaymentCount        Int      @default(0)
  dueToday                  Decimal  @default(0) @db.Decimal(14, 2)
  dueNext7Days              Decimal  @default(0) @db.Decimal(14, 2)
  totalDues                 Decimal  @default(0) @db.Decimal(14, 2)
  totalPayback              Decimal  @default(0) @db.Decimal(14, 2)
  collectionEfficiency      Float    @default(0)
  lastRefreshedAt           DateTime @default(now())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime
}

enum CollectionPaymentSource {
  SYSTEM
  MANUAL
}

enum CollectionPaymentStatus {
  PAID
  FAILED
  DUE_TODAY
  UPCOMING
  SCHEDULED
  MANUAL
  WAIVED
  CREDIT
  DEBIT
}

enum PaymentTemplateType {
  contract
  email
  letter
}
