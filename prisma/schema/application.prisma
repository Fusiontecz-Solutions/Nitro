model Iso {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String
  email                String?
  phone                String?
  bankAccountNo        String
  routingNumber        String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  commissionPercentage Float
  /// Uploaded ISO portal documents: [{ id, url, originalName?, publicId?, uploadedAt, category? }]
  documents            Json         @default("[]")
  /// When the ISO accepted the portal agreement (persisted; replaces localStorage-only flow).
  agreementAcceptedAt  DateTime?
  /// Lifecycle status: active | inactive | suspended
  status               String       @default("active") @db.VarChar(16)
  /// Assigned commission tier (see IsoTier). Null = legacy/flat commissionPercentage.
  tierId               String?      @db.Uuid
  applications         Application[]
}

enum Role {
  AGENT
  SCRUBBING
  UNDERWRITER
  ACCOUNTANT
  ADMIN
  OPERATIONS
  SYNDICATOR
  SUPER_ADMIN
  ACCOUNTS
}

enum RequestStatus {
  CREATED
  REQUEST
  RECEIVED
  VERIFIED
}

/// Gmail conversation used for a workflow email (e.g. Agent -> ISO approval request).
/// Follow-up sends reply on the same thread so the ISO sees one chain per deal.
model ApplicationEmailThread {
  id               String      @id @default(uuid()) @db.Uuid
  applicationId    String      @db.Uuid
  /// ISO_APPROVAL for the Agent -> ISO approval chain.
  purpose          String      @db.VarChar(32)
  /// User whose connected Gmail mailbox owns the thread.
  ownerUserId      String?     @db.Uuid
  mailboxEmail     String?
  gmailThreadId    String
  /// RFC 5322 Message-ID of the latest message we sent (used for In-Reply-To).
  lastMessageId    String?
  /// Accumulated References header for threading.
  references       String?
  subject          String?
  counterpartEmail String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  owner            User?       @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@unique([applicationId, purpose])
  @@index([gmailThreadId])
}
