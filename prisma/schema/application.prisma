  termsOfferId        Int                  @unique @default(autoincrement())
  approvedAmount      Float
  factorRate          Float
  paybackAmount       Float
  numberOfPayments    Int
  offerExpiryDate     DateTime
  termLength          Int
  commissionPercent   Float
  paymentAmount       Float
  percentOfGross      Float
  frequency           String
  buyRate             Float
  commissionAmount    Float
  position            String
  paymentSchedule     String
  paymentDays         String[]             @default([])
  applicationId       String               @db.Uuid
