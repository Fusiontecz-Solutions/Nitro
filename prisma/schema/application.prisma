model ContractTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  url          String
  publicId     String
  originalName String?
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  layoutKey    String   @default("contract")
