model ClientOwner {
  id                  String    @id @default(uuid()) @db.Uuid
  clientId            String    @db.Uuid
  sortOrder           Int       @default(0)
  firstName           String
  middleName          String?
  lastName            String
  email               String?
  mobileNumber        String?
  dateOfBirth         DateTime?
  ssn                 String?
  ficoScore           Int?
  ownershipStartDate  DateTime?
  ownershipPercentage Float?
  address1            String?
  address2            String?
  city                String?
  state               String?
  zipCode             String?
