model ApplicationQuestionResponse {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @db.Uuid
  questionId    String
  questionText  String
  answer        String
  reason        String?     @default("")
  updatedById   String      @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id])
  updatedBy     User        @relation("ApplicationQuestionUpdatedBy", fields: [updatedById], references: [id])

  @@unique([applicationId, questionId])
  @@index([updatedById])
}

model Document {
  id                Int         @id @default(autoincrement())
  applicationId     String      @unique @db.Uuid
  envelopeId        String      @unique
  status            String
  sentAt            DateTime?
  completedAt       DateTime?
  /// Cloudinary URL for the signed combined PDF (avoids re-hitting DocuSign after complete).
  signedPdfUrl      String?
  signedPdfPublicId String?
  /// sha256 of the package structure + CRM prefill values behind `envelopeId`.
  /// Reuse of the SignNow draft group is gated on this: when the contract is
  /// edited and sent again the hash changes and the group is rebuilt instead of
  /// re-prefilled, so previously baked page text cannot survive as stale values.
  prefillFingerprint String?
  /// Set when the contract was emailed to signers through the CRM signing portal
  /// (SendGrid) instead of a SignNow group invite. Portal sends use the preparer's
  /// embedded invite, which otherwise reads as "owner review still open" and would
  /// be rolled back to draft by revertPrematureSentIfOwnerReview.
  portalSentAt      DateTime?
  /// CC addresses this envelope was sent to, captured at send time.
  /// The CC list only ever lived in the send request body, so once the signers
  /// finished there was nothing left to tell the completion notice who had been
  /// copied. Persisting it here lets the signed-package email reach the same
  /// people who received the unsigned copy.
  ccEmails          String[]    @default([])
  /// When the "contract signed" notice with the signed PDF reached the CC list.
  /// Null until at least one CC address was emailed, so the application's
  /// "Signed copy sent to CC" checkbox ticks itself only once delivery happened.
  ccSignedNoticeSentAt DateTime?
  /// CC addresses the signed-contract notice was actually delivered to.
  ccSignedNoticeEmails String[] @default([])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  userId            Int
  application       Application @relation(fields: [applicationId], references: [id])
}

/// Cached SignNow template documents (field face, roles, page count).
/// Templates change rarely but are read on nearly every prefill, so the JSON is
/// kept here and refreshed on TTL instead of re-fetched from SignNow per request.
/// Survives process restarts and is shared across instances, unlike the
/// in-process cache it backs.
model SignNowTemplateCache {
  id           String   @id @default(uuid()) @db.Uuid
  /// SignNow document/template id.
  templateId   String   @unique
  documentName String?
  /// Raw GET /document payload.
  document     Json
  fetchedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([fetchedAt])
}

/// Permanent Cloudinary archive of a blank SignNow template PDF.
///
/// Keyed by the SignNow template id so one row serves every preview of that
/// template — main agreement, addendum, disclosure or exhibit alike. Rows have
/// no TTL: the PDF is re-fetched from SignNow only when the archive is missing
/// or explicitly invalidated (template link repointed).
model SignNowTemplatePdf {
  id                String   @id @default(uuid()) @db.Uuid
  /// SignNow document-group template id this PDF was rendered from.
  signnowTemplateId String   @unique
  /// SignNow origin document id the PDF bytes were downloaded from.
  originDocumentId  String?
  /// Catalog layout key (`exhibit_c`, `signnow_disclosure`, …) when known.
  layoutKey         String?
  name              String?
  /// `contract` | `addendum` | `disclosure`.
  type              String?
  /// Cloudinary delivery URL for the archived PDF.
  pdfUrl            String
  pdfPublicId       String?
  byteSize          Int?
  fetchedAt         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([layoutKey])
  @@index([fetchedAt])
}

/// One SignNow email group-invite per document-group (envelopeId). Used for send idempotency.
model SignNowInviteSend {
  id            String    @id @default(uuid()) @db.Uuid
  envelopeId    String    @unique
  applicationId String?   @db.Uuid
  contractId    Int?
  /// NOT_SENT | SENDING | SENT | FAILED
  sendStatus    String    @default("NOT_SENT")
  inviteId      String?
  attemptCount  Int       @default(0)
  lastErrorCode String?
  requestId     String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([applicationId])
  @@index([sendStatus])
}

/// Owner review of a SignNow document group (envelopeId), persisted server-side.
/// The CRM used to hold "review finished" only in browser memory, so a refresh,
/// a closed tab or an expired session put the footer back on "Review in SignNow"
/// for a package the preparer had already finished. `startedAt` is when the
/// review link was minted (it also scopes SignNow's finish evidence to this
/// review); `completedAt` is when SignNow confirmed the Finish.
model SignNowReviewSession {
  id             String    @id @default(uuid()) @db.Uuid
  envelopeId     String    @unique
  startedAt      DateTime
  completedAt    DateTime?
  fulfilledRoles String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([completedAt])
}

model Addendum {
  id                    Int           @id @default(autoincrement())
  clientId              String        @db.Uuid
  legalName1            String?
  dba1                  String?
  typeOfEntity1         String?
  ein1                  String?
  mailingAddress1       String?
  legalName2            String?
  dba2                  String?
  typeOfEntity2         String?
  ein2                  String?
  mailingAddress2       String?
  legalName3            String?
  dba3                  String?
  typeOfEntity3         String?
  ein3                  String?
  mailingAddress3       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  contractId            Int?
  businessInfoId        Int?
  addendumDated         String?
  businessLocation      String?
  principalBusiness     String?
  principalOwner        String?
  principalOwner1Date   String?
  principalOwner1Name   String?
  principalOwner2Date   String?
  principalOwner2Name   String?
  principalOwnerAmount1 String?
  principalOwnerAmount2 String?
  principalState        String?
  businessInfo          BusinessInfo? @relation("AddendumBusinessInfo", fields: [businessInfoId], references: [id])
  client                Client        @relation(fields: [clientId], references: [id])
  contract              Contract?     @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([businessInfoId])
}

