/// Admin-configured DocuSign JWT account used per funder.
model DocuSignAccountProfile {
  id                 String          @id @default(uuid()) @db.Uuid
  name               String
  integrationKey     String
  clientSecret       String?
  impersonatedUserId String
  rsaPrivateKey      String
  accountId          String?
  baseUri            String?
  defaultRoleName    String          @default("Signer")
  webhookUser        String?
  webhookPassword    String?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  funders            FunderProfile[]

  @@index([name])
  @@index([isActive])
}

/// Funder configuration: contract layout, state rules, linked DocuSign account.
model FunderProfile {
  id                       String                  @id @default(uuid()) @db.Uuid
  name                     String                  @unique
  displayName              String?
  dealIdPrefix             String?
  assignsDealId            Boolean                 @default(false)
  mainContractLayoutKey    String                  @default("contract")
  contractPdfFileName      String?
  /// State codes/names when this funder appears in dropdown; empty = all states.
  allowedStates            Json?
  organization             String?
  legalName                String?
  contactEmail             String?
  contactPhone             String?
  addressLine1             String?
  addressCity              String?
  addressState             String?
  addressZip               String?
  docusignAccountProfileId String?                 @db.Uuid
  sortOrder                Int                     @default(0)
  isActive                 Boolean                 @default(true)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  /// State codes/names where this funder is hidden; empty = no exclusions.
  excludedStates           Json?
  /// Default DocuSign CC email for contract sends (falls back to platform default when empty).
  defaultCcEmail           String?
  /// Addendum/disclosure PDF source: platform | own | shared (contract PDF is always per-funder).
  documentsSource          String                  @default("own")
  /// When documentsSource is shared, layout keys use this funder's uploaded PDFs.
  sharedDocumentsFunderId  String?                 @db.Uuid
  /// Per-document addendum source; falls back to documentsSource when null.
  addendumDocumentsSource  String?
  /// Per-document disclosure source; falls back to documentsSource when null.
  disclosureDocumentsSource String?
  /// When addendumDocumentsSource is shared, reuse this funder's addendum PDFs.
  sharedAddendumFunderId   String?                 @db.Uuid
  /// When disclosureDocumentsSource is shared, reuse this funder's disclosure PDFs.
  sharedDisclosureFunderId String?                 @db.Uuid
  docusignAccountProfile   DocuSignAccountProfile? @relation(fields: [docusignAccountProfileId], references: [id])

  @@index([docusignAccountProfileId])
  @@index([isActive])
  @@index([sortOrder])
}
