model BoldSignTemplate {
  name       String
  type       String
  state      String?
  templateId String
  createdAt  DateTime @default(now())
  frequency  String?
  id         String   @id @default(uuid()) @db.Uuid
}

model ContractClient {
  id          Int      @id @default(autoincrement())
  contractId  Int
  clientId    String   @db.Uuid
  signerOrder Int?
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model ContractOwner {
  id                  Int      @id @default(autoincrement())
  contractId          Int
  firstName           String
  lastName            String
  email               String?
  phone               String?
  address             String?
  state               String?
  city                String?
  zip                 String?
  ownershipPercentage Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  contract            Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model ContractGuarantor {
  id         Int      @id @default(autoincrement())
  contractId Int
  firstName  String
  lastName   String
  email      String?
  phone      String?
  address    String?
  state      String?
  city       String?
  zip        String?
  ssn        String?

  driverLicense String?
  entityType          String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model PaymentTerms {
  id                Int              @id @default(autoincrement())
  paymentFrequency  PaymentFrequency
  paymentDays       PaymentDays[]
  gracePeriodDays   Int?
  lateFeePercentage Float?
  lateFeeFlatAmount Float?
  paymentMethod     PaymentMethod
  paymentProcessor  PaymentProcessor
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  contractId        Int?
  contract          Contract?        @relation(fields: [contractId], references: [id])
}

model RepaymentSchedule {
  id          Int                   @id @default(autoincrement())
  contractId  Int
  dueDate     DateTime
  amount      Float
  status      String
  paymentDate DateTime?
  notes       String?
  paymentId   Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  contract    Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  transaction RepaymentTransaction?
}

model RepaymentTransaction {
  id                  Int               @id @default(autoincrement())
  contractId          Int
  repaymentScheduleId Int               @unique
  amount              Float
  paymentDate         DateTime
  dueDate             DateTime
  status              PaymentStatus     @default(PENDING)
  method              PaymentMethod?
  referenceNumber     String?
  fees                Float?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  contract            Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  repaymentSchedule   RepaymentSchedule @relation(fields: [repaymentScheduleId], references: [id])
}

enum PaymentMethod {
  ACH
  CHECK
  CREDIT_CARD
  DEBIT_CARD
  WIRE_TRANSFER
  MOBILE_PAYMENT
  BANK_DRAFT
  PAYPAL
  OTHER
}

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  COMPLETED
  DECLINED
  REVOKED
  EXPIRED
}

enum PaymentProcessor {
  ACTUM
  STRIPE
  PAYPAL
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  PARTIAL
}
