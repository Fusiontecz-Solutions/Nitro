  startDate             DateTime
  endDate               DateTime
  contractLenght        Int
  approvedAmount        Float
  totalAmount           Float
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdById           String                 @db.Uuid
  agreementDate         DateTime
  paymentBankId         String                 @db.Uuid
  status                ContractStatus         @default(DRAFT)
  funderName            String?
  state                 String?
