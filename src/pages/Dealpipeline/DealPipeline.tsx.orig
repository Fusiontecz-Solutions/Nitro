                placeholder="Search merchants..."
                className="h-11 w-[260px] rounded-xl bg-background border border-border pl-10 pr-3 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-[#276D9C]/30"
              />
            </div>

            <div className="inline-flex p-1 rounded-xl bg-muted/40 border border-border">
              <button
                onClick={() => setViewMode("list")}
                className={`h-9 w-10 rounded-lg inline-flex items-center justify-center transition-colors ${viewMode === "list"
                    ? "bg-[#276D9C] text-white"
                    : "text-muted-foreground hover:text-foreground hover:bg-accent"
                  }`}
                aria-label="List view"
              >
                <List size={16} />
              </button>
              <button
                onClick={() => setViewMode("grid")}
                className={`h-9 w-10 rounded-lg inline-flex items-center justify-center transition-colors ${viewMode === "grid"
                    ? "bg-[#276D9C] text-white"
                    : "text-muted-foreground hover:text-foreground hover:bg-accent"
                  }`}
                aria-label="Grid view"
              >
                <Grid2x2 size={16} />
              </button>
            </div>
          </div>
        </div>

        {listError && (
          <div className="px-6 py-8 text-center text-destructive text-sm" role="alert">
            {listError}
          </div>
        )}

        {listLoading && !listError && (
          <div className="flex items-center justify-center gap-2 py-16 text-muted-foreground">
            <Loader2 className="h-6 w-6 animate-spin" />
            <span>Loading deals…</span>
          </div>
        )}

        {!listLoading && !listError && totalFilteredDeals > 0 && (
          <AnimatePresence mode="wait">
            {viewMode === "list" ? (
              <motion.div
                key="list-view"
                initial={{ opacity: 0, y: 8 }}
                animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0, y: -6 }}
                transition={{ duration: 0.22 }}
                className="overflow-x-auto"
              >
                <table className="w-full text-left border-collapse">
                  <thead>
                    <tr className="border-b border-border bg-accent/20">
                      <th className="px-6 py-4 text-[13px] font-bold  text-gray-600  uppercase tracking-widest">
                        Business Name
                      </th>
                      <th className="px-6 py-4 text-[13px] font-bold  text-gray-600  uppercase tracking-widest">
                        Agent
                      </th>
                      <th className="px-6 py-4 text-[13px] font-bold  text-gray-600  uppercase tracking-widest">
                        Updated
                      </th>
                      <th className="px-6 py-4 text-[13px] font-bold  text-gray-600  uppercase tracking-widest">
                        Amount
                      </th>
                      <th className="px-6 py-4 text-[13px] font-bold  text-gray-600  uppercase tracking-widest">
                        Approved
                      </th>
                      <th className="px-6 py-4 text-[13px] font-bold  text-gray-600  uppercase tracking-widest text-right">
                        Action
                      </th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-border">
                    {paginatedDeals.map((deal) => (
                      <tr
                        key={deal.id}
                        className="hover:bg-accent/30 transition-colors group"
                      >
                        <td className="px-6 py-4">
                          <div className="flex flex-col">
                            <span className="text-sm font-medium text-foreground group-hover:text-foreground transition-colors">
                              {deal.merchant}
                            </span>
                            <span className="text-[11px] text-muted-foreground font-medium">
                              {deal.code}
                            </span>
                          </div>
                        </td>
                        <td className="px-6 py-4 text-sm text-muted-foreground font-medium">
                          {deal.owner}
                        </td>
                        <td className="px-6 py-4 text-sm text-muted-foreground font-medium">
                          {deal.updatedAt}
                        </td>
                        <td className="px-6 py-4 text-sm font-bold text-foreground">
                          {formatCurrency(deal.amount)}
                        </td>
                        <td className="px-6 py-4 text-sm font-semibold text-foreground">
                          {deal.approvedAmount != null ? (
                            formatCurrency(deal.approvedAmount)
                          ) : (
                            <span className="text-muted-foreground font-normal">Pending</span>
                          )}
                        </td>
                        <td className="px-6 py-4 text-right">
                          <button
                            onClick={() => navigate(`/deal-pipeline/${deal.id}`)}
                            className="inline-flex cursor-pointer items-center gap-1 text-xs font-bold text-muted-foreground hover:text-[#276D9C] transition-colors uppercase tracking-tighter"
                          >
                            <Eye size={20} className="opacity-50" />
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </motion.div>
            ) : (
              <motion.div
                key="grid-view"
                initial={{ opacity: 0, y: 8 }}
                animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0, y: -6 }}
                transition={{ duration: 0.22 }}
                className="p-5 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"
              >
                {paginatedDeals.map((deal) => {
                  return (
                    <div
                      key={deal.id}
                      className="rounded-xl border border-border bg-background p-4 hover:bg-accent/20 transition-colors"
                    >
                      <div className="flex items-start justify-between gap-3">
                        <div>
                          <h3 className="text-sm font-semibold text-foreground">{deal.merchant}</h3>
                          <p className="text-xs text-muted-foreground mt-1">{deal.code}</p>
                        </div>
                        <span
                          className={`text-xs font-semibold whitespace-nowrap ${deal.approvedAmount != null ? "text-foreground" : "text-muted-foreground font-normal"}`}
                        >
                          <span>Approved Amount: </span>
                          {deal.approvedAmount != null
                            ? formatCurrency(deal.approvedAmount)
                            : "Pending"}
                        </span>
                      </div>
                      <div className="mt-4 space-y-1 text-sm">
                        {/* <p className="text-muted-foreground">Owner: {deal.owner}</p> */}
                        <p className="text-muted-foreground">Agent: {deal.iso}</p>
                        <p className="text-muted-foreground">Updated: {deal.updatedAt}</p>
                        <p className="text-foreground font-semibold">Requested Amount: {formatCurrency(deal.amount)}</p>
                      </div>
                      <div className=" flex justify-end">
                        <button
                          onClick={() => navigate(`/deal-pipeline/${deal.id}`)}
                          className="inline-flex cursor-pointer items-center gap-1 text-xs font-bold text-muted-foreground hover:text-[#276D9C] transition-colors uppercase tracking-tighter"
                        >
                          <Eye size={19} className="opacity-50" />
                        </button>
                      </div>
                    </div>
                  );
                })}
              </motion.div>
            )}
          </AnimatePresence>
        )}

        {!listLoading && !listError && totalFilteredDeals === 0 && (
          <div className="px-6 py-10 text-center text-muted-foreground text-sm">
            No deals found
            {searchTerm.trim() ? ` for "${searchTerm}".` : " for this stage."}
          </div>
        )}

        {!listLoading && !listError && totalFilteredDeals > 0 && (
          <div className="px-6 py-4 border-t border-border flex items-center justify-between text-xs font-bold text-muted-foreground bg-accent/20">
            <span>
              Showing {showingStart} to {showingEnd} of {totalFilteredDeals} entries
            </span>
            <div className="flex items-center gap-1">
              <button
                onClick={() => setCurrentPage(1)}
                disabled={safeCurrentPage === 1}
                className="h-7 w-7 inline-flex items-center justify-center rounded-md border border-border bg-background text-muted-foreground hover:text-foreground hover:bg-accent/60 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                aria-label="First page"
              >
                <ChevronsLeft size={14} />
              </button>
              <button
                onClick={() => setCurrentPage((prev) => Math.max(1, prev - 1))}
                disabled={safeCurrentPage === 1}
                className="h-7 w-7 inline-flex items-center justify-center rounded-md border border-border bg-background text-muted-foreground hover:text-foreground hover:bg-accent/60 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                aria-label="Previous page"
              >
                <ChevronLeft size={14} />
              </button>
              {Array.from({ length: totalPages }, (_, idx) => idx + 1).map((page) => (
                <button
                  key={page}
                  onClick={() => setCurrentPage(page)}
                  className={`h-7 min-w-7 px-2 inline-flex items-center justify-center rounded-md border text-[11px] font-semibold transition-colors ${safeCurrentPage === page
                      ? "bg-[#276D9C] border-[#276D9C] text-white"
                      : "bg-background border-border text-muted-foreground hover:text-foreground hover:bg-accent/60"
                    }`}
                  aria-label={`Page ${page}`}
                >
                  {page}
                </button>
              ))}
              <button
                onClick={() =>
                  setCurrentPage((prev) => Math.min(totalPages, prev + 1))
                }
                disabled={safeCurrentPage === totalPages}
                className="h-7 w-7 inline-flex items-center justify-center rounded-md border border-border bg-background text-muted-foreground hover:text-foreground hover:bg-accent/60 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                aria-label="Next page"
              >
                <ChevronRight size={14} />
              </button>
              <button
                onClick={() => setCurrentPage(totalPages)}
                disabled={safeCurrentPage === totalPages}
                className="h-7 w-7 inline-flex items-center justify-center rounded-md border border-border bg-background text-muted-foreground hover:text-foreground hover:bg-accent/60 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                aria-label="Last page"
              >
                <ChevronsRight size={14} />
              </button>
>>>>>>> origin/Development1
            </div>
          ) : viewMode === "list" ? (
            <div className="overflow-x-auto rounded-xl">
              <DataTableContent
                table={table}
                loading={listBlockingLoad}
                loadingMessage="Loading deals…"
                emptyMessage="No deals found"
                emptySubMessage={
                  searchTerm.trim()
                    ? `Try a different search than "${searchTerm.trim()}"`
                    : "No applications in this stage"
                }
                onRowClick={(row) => goToDeal(row.original)}
              />
            </div>
          ) : listBlockingLoad ? (
            <div className="flex items-center justify-center py-20 rounded-xl">
              <Loader2 className="h-8 w-8 animate-spin text-primary shrink-0" />
              <span className="ml-2 text-muted-foreground">Loading deals…</span>
            </div>
          ) : !stageDeals.length ? (
            <div className="flex flex-col items-center justify-center py-16 px-4 text-center rounded-xl">
              <p className="font-medium text-[#687182]">No deals found</p>
              <p className="text-sm text-muted-foreground mt-1">
                {searchTerm.trim()
                  ? `Try adjusting your search for "${searchTerm.trim()}"`
                  : "No applications in this stage"}
              </p>
            </div>
          ) : (
            <div className="p-3 md:p-4">
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                {stageDeals.map((deal) => (
                  <div
                    key={deal.id}
                    role="group"
                    tabIndex={0}
                    onClick={() => goToDeal(deal)}
                    onKeyDown={(e) => {
                      if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        goToDeal(deal);
                      }
                    }}
                    aria-label={`Open deal ${deal.code}`}
                    className={`rounded-lg border shadow-sm flex flex-col gap-3 p-4 text-left transition hover:ring-2 hover:ring-[#276D9C]/20 cursor-pointer ${
                      isDark ? "bg-[#1a1b1e] border-[#374151]" : "bg-card border-[#F0F0F0]"
                    }`}
                  >
                    <div className="flex items-start justify-between gap-2">
                      <div className="min-w-0 flex-1">
                        <p className="font-semibold text-foreground truncate">{deal.merchant}</p>
                        <p className="text-xs text-muted-foreground mt-0.5">
                          <span className="text-sky-600 font-medium">{deal.code}</span>
                        </p>
                      </div>
                      <button
                        type="button"
                        onClick={(e) => {
                          e.stopPropagation();
                          openPreviewForDealId(deal.id);
                        }}
                        className="shrink-0 flex h-8 w-8 items-center justify-center rounded-full border border-[#276D9C] text-[#276D9C] hover:bg-[#276D9C]/10"
                        aria-label="Preview application in drawer"
                      >
                        <EyeIcon className="h-4 w-4" />
                      </button>
                    </div>
                    <div className="text-xs text-muted-foreground space-y-1">
                      <p>
                        <span className="text-foreground/80">Agent: </span>
                        {deal.owner}
                      </p>
                      <p>
                        <span className="text-foreground/80">Updated: </span>
                        {deal.updatedAt}
                      </p>
                      <p>
                        <span className="text-foreground/80">Requested Amount: </span>
                        {formatCurrency(deal.amount)}
                      </p>
                      <p>
                        <span className="text-foreground/80">Approved Amount: </span>
                        {deal.approvedAmount != null
                          ? formatCurrency(deal.approvedAmount)
                          : "Pending"}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        {stageDeals.length > 0 && !listError && (
          <DataTablePagination table={table} totalItems={totalFilteredDeals} showSelectedCount={false} />
        )}
      </div>

      <ApplicationDetailsSheet
        application={viewApplication}
        open={!!viewApplication}
        onOpenChange={(open) => {
          if (!open) setViewApplication(null);
        }}
      />
    </motion.div>
  );
}
